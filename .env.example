# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Admin Configuration (tua email GitHub o email consentita per accedere alla dashboard)
ADMIN_EMAIL=your-email@example.com

# Site URL Configuration (dominio canonico del sito, senza trailing slash)
# In produzione: https://www.tuodominio.it (o https://tuodominio.vercel.app temporaneo)
# In preview/dev: lasciare vuoto per fallback automatico a VERCEL_URL o localhost
NEXT_PUBLIC_SITE_URL=

# Resend Email Configuration (per invio email transazionali dal modulo contatti)
# Registrati gratuitamente su https://resend.com per ottenere la chiave API
RESEND_API_KEY=re_your_api_key_here
# Mittente email (in fase di test: onboarding@resend.dev, con dominio verificato: contatto@tuodominio.it)
CONTACT_EMAIL_FROM="Portfolio <onboarding@resend.dev>"

# Cloudflare Turnstile Configuration (protezione anti-bot intelligente e invisibile)
# Crea gratuitamente un widget su https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
